# ─── Supabase PostgreSQL ─────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:[password]@db.[ref].supabase.co:5432/postgres

# ─── Firebase ────────────────────────────────────────────────────────────────
# Server (firebase-admin uses Application Default Credentials in Functions)
# For local dev: set GOOGLE_APPLICATION_CREDENTIALS to a service account JSON path
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
FIREBASE_PROJECT_ID=petapp-38f4a

# ─── Server ──────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3001,capacitor://localhost

# ─── Web (Vite) ──────────────────────────────────────────────────────────────
# Firebase Web SDK config for project: petapp-38f4a (Pet-PAWSphere / PawMatch Web)
# Copy secret values from:
#   https://console.firebase.google.com/project/petapp-38f4a/settings/general
# The non-secret identifiers below (authDomain, projectId, storageBucket) are
# fixed to the project and safe to keep as-is.
VITE_FIREBASE_API_KEY=your-web-api-key
VITE_FIREBASE_AUTH_DOMAIN=petapp-38f4a.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=petapp-38f4a
VITE_FIREBASE_STORAGE_BUCKET=petapp-38f4a.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
VITE_FIREBASE_APP_ID=your-app-id
VITE_FIREBASE_MEASUREMENT_ID=your-measurement-id

# App Check (optional — enables bot protection)
# VITE_RECAPTCHA_SITE_KEY=your-recaptcha-enterprise-site-key

# ─── Google AI (Gemini) ──────────────────────────────────────────────────────
# Required until Phase 4: genkit.ts uses @genkit-ai/google-genai directly.
# Get from: https://aistudio.google.com/app/apikey
# TODO Phase 4: swap to @genkit-ai/vertexai → billed through Firebase, no key needed
GOOGLE_GENAI_API_KEY=your-google-ai-api-key

# ─── PostHog Analytics ───────────────────────────────────────────────────────
# Get from: PostHog Project Settings → Project API key
VITE_POSTHOG_KEY=phc_your_project_key
# Optional: override host for self-hosted PostHog
# VITE_POSTHOG_HOST=https://us.i.posthog.com

# ─── Monetization (dark-launched) ────────────────────────────────────────────
# Both flags default to "false". Flip to "true" once Stripe is configured.
# The web component and Cloud Functions no-op while disabled.
MONETIZATION_ENABLED=false
VITE_MONETIZATION_ENABLED=false

# Stripe — server (Firebase Functions secrets recommended, not this file)
# In production: `firebase functions:secrets:set STRIPE_SECRET_KEY` etc.
STRIPE_SECRET_KEY=sk_test_your_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_signing_secret
STRIPE_PRICE_BOOST_24H=price_your_boost_price_id

# Stripe — client
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key
# The 24h boost Stripe Price ID — exposed to the web bundle so <Paywall/> can call it
VITE_STRIPE_PRICE_BOOST_24H=price_your_boost_price_id

# Web origin used by Checkout success/cancel URLs
WEB_ORIGIN=http://localhost:5173

# ─── Error monitoring ───────────────────────────────────────────────────────
# Server: set in Firebase Functions secret for production
#   firebase functions:secrets:set SENTRY_DSN
# Local: paste your DSN below (leave blank to disable Sentry)
SENTRY_DSN=
# Web (build-time env): same value prefixed for Vite
VITE_SENTRY_DSN=

# ─── Removed ─────────────────────────────────────────────────────────────────
# JWT_SECRET  → replaced by Firebase Auth token verification
